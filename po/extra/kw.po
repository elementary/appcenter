#: data/appcenter.metainfo.xml.in:213 data/appcenter.metainfo.xml.in:233
#: data/appcenter.metainfo.xml.in:248 data/appcenter.metainfo.xml.in:262
msgid "Other Improvements:"
msgstr "Gwellheansow Erel:"

#: data/appcenter.metainfo.xml.in:72 data/appcenter.metainfo.xml.in:87
#: data/appcenter.metainfo.xml.in:101 data/appcenter.metainfo.xml.in:113
#: data/appcenter.metainfo.xml.in:134 data/appcenter.metainfo.xml.in:147
#: data/appcenter.metainfo.xml.in:167 data/appcenter.metainfo.xml.in:188
#: data/appcenter.metainfo.xml.in:216 data/appcenter.metainfo.xml.in:238
#: data/appcenter.metainfo.xml.in:250 data/appcenter.metainfo.xml.in:264
msgid "Updated translations"
msgstr "Treylyansow nowedhys"

#: data/appcenter.metainfo.xml.in:73
msgid "Performance improvements"
msgstr "Gwellheansow tooth"

#: data/appcenter.metainfo.xml.in:179 data/appcenter.metainfo.xml.in:209
#: data/appcenter.metainfo.xml.in:229 data/appcenter.metainfo.xml.in:257
msgid "New features:"
msgstr "Nasyow nowydh:"

#: data/appcenter.metainfo.xml.in:181
msgid "Manage autostart in System Settings → Applications"
msgstr "Dyghtya awtodalleth yn Settyansow Kevreyth → Appys"

#: data/appcenter.metainfo.xml.in:185
msgid "Automatic app updates by default"
msgstr "Nowedhyansow app awtomatek dre dhefowt"

#: data/appcenter.metainfo.xml.in:186
msgid "OS Updates have moved to System Settings"
msgstr "Nowedhyansow KO re wayas dhe Settyansow Kevreyth"

#: data/appcenter.metainfo.xml.in:187
msgid ""
"Badge apps made for elementary OS instead of badging apps from other remotes"
msgstr ""
"Arwodha appys gwrys rag elementary OS yn le owth arwodha appys a "
"bellwithvaow erel"

#: data/appcenter.metainfo.xml.in:211
msgid "Warn when apps use legacy Autostart, Notifications"
msgstr "Gwarnya pan eus appys ow tevnydhya Awtodalleth ha Gwarnyansow anterrus"

#: data/appcenter.metainfo.xml.in:215
msgid "Fix flickering on AppInfo views when getting install size"
msgstr "Ewnhe flyckrans yn gwelyow AppInfo hag ow kerghes braster leans"

#: data/appcenter.metainfo.xml.in:231
msgid ""
"Warn when apps have access to Home or system folders, location, settings, or "
"have an insecure sandbox."
msgstr ""
"Gwarnya pan eus appys gans hedhas dhe restrenvaow Tre po kevreyth, tyller, "
"settyansow, po gans kowel andhiogel."

#: data/appcenter.metainfo.xml.in:235
msgid "Tighten up spacing and margins in App Info views"
msgstr "Tynnhe spas hag emlow yn gwelyow Kedhlow App"

#: data/appcenter.metainfo.xml.in:236
msgid "Show a placeholder banner on the home page when loading"
msgstr "Diskwedhes baner anbarghus war'n folen dre yn kargans"

#: data/appcenter.metainfo.xml.in:237
msgid "Don't list non-AppCenter apps under a separate header in category views"
msgstr "Ny rolya appys di-Appva a-woles dhe bennlinen dhiblans yn gwelyow klass"

#: data/appcenter.metainfo.xml.in:259
msgid "Offer a Repair option if Flatpak updates fail"
msgstr "Offra dewis Ewnhe mar fyllons nowedhyansow Flatpak"

#: data/appcenter.metainfo.xml.in:260
msgid ""
"Show a message in the updates view when up to date, including when updates "
"were last checked"
msgstr ""
"Diskwedhes messach y'n gwel nowedhyans pan nowedhys, ow komprehendya p'eur "
"esa nowedhyansow checkys diwettha"

#: data/io.elementary.appcenter.desktop.in.in:8
msgid "install;uninstall;remove;catalogue;store;apps;software;"
msgstr "lea;dilea;remova;rolas;menegva;gwerthji;appys;medhelweyth;"

#: data/io.elementary.appcenter.desktop.in.in:25
msgid "Check for Updates"
msgstr "Checkya rag Nowedhyansow"

#: data/io.elementary.appcenter.policy.in:10
msgid "Repair software sources"
msgstr "Ewnhe pennfentynnyow medhelweyth"

#: data/io.elementary.appcenter.policy.in:11
msgid "Authentication is required to repair software sources"
msgstr "Res yw dhywgh omwirhe rag ewnhe pennfentynnyow medhelweyth"
